{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"<SKILL_DIR>/scripts/quota_guard.mjs\" refresh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"<SKILL_DIR>/scripts/quota_guard.mjs\" gate",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
